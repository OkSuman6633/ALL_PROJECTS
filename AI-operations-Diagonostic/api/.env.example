AOD_ENVIRONMENT=local
AOD_DATA_DIR=./data
AOD_AUTH_MODE=demo
AOD_DEMO_TOKEN=local-demo-token-change-me
AOD_MAX_UPLOAD_MB=10
AOD_MAX_FILES_PER_ASSESSMENT=5
# Optional: enables Gemini-assisted candidate extraction. Never place real customer data in a demo environment.
AOD_GEMINI_API_KEY=
AOD_GEMINI_MODEL=gemini-2.5-flash
AOD_GCP_PROJECT_ID=
AOD_GCS_STATE_BUCKET=
AOD_GCS_SOURCE_BUCKET=
AOD_GCS_REPORT_BUCKET=
