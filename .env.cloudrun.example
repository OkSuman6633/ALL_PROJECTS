# Unified Cloud Run Environment Template (All 6 Projects)
# Pass needed keys when deploying (or via Secret Manager / --set-env-vars).

# Shared AI Key (automatically propagated to GEMINI_API_KEY, GOOGLE_API_KEY, and AOD_GEMINI_API_KEY)
GEMINI_API_KEY=
# Optional OpenAI fallback for Contract-Invoice-Leakage-Finder
OPENAI_API_KEY=

# Unified data root inside container (SQLite DBs + uploaded files)
UNIFIED_DATA_DIR=/app/data

# 1. Agent_Assurence
AGENT_ASSURENCE_ENVIRONMENT=production
AGENT_ASSURENCE_AUTH_DISABLED=false
AGENT_ASSURANCE_DEV_ALLOW_PRIVATE_HOSTS=true

# 2. AI-operations-Diagonostic
AOD_ENVIRONMENT=local
AOD_AUTH_MODE=demo
AOD_DEMO_TOKEN=local-demo-token-change-me

# 3. Construction-variation-tracker
CONSTRUCTION_APP_ENV=local
AUTH_DEV_HS256_SECRET=change-this-to-a-32-char-random-secret-string

# 4. Contract-Invoice-Leakage-Finder
LEAKAGE_ENVIRONMENT=production
LEAKAGE_SECRET_KEY=change-this-leakage-jwt-secret

# 5. Industry-Specific-Lead-to-Order-Agent
LEAD_TO_ORDER_ENVIRONMENT=production
LEAD_TO_ORDER_JWT_SECRET=change-this-lead-to-order-jwt-secret
ALLOW_DEMO_LOGIN=true

# 6. Procurement-Quote-Comparison-Agent
PROCUREAI_APP_ENV=production
PROCUREAI_SESSION_COOKIE_SECURE=false
PROCUREAI_SESSION_SECRET_KEY=change-this-procureai-session-secret
